rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // SkillItem validation
    function isValidSkill(data) {
      return data.keys().hasAll(['id', 'domain', 'skill']) &&
        data.id is number &&
        data.domain is string && data.domain.size() <= 200 &&
        data.skill is string && data.skill.size() <= 200;
    }

    // UserProfile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 150 &&
        data.email is string && data.email.size() <= 150;
    }

    // AuditLog validation
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'performedBy']) &&
        data.id is string && data.id.size() <= 128 &&
        data.timestamp is string &&
        data.performedBy is string && data.performedBy.size() <= 100;
    }

    // /skills/{skillId} collection
    match /skills/{skillId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSkill(incoming());
      allow delete: if isSignedIn();
    }

    // /users/{userId} collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // /audit_logs/{logId} collection
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
